#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

case "${1:-}" in
-h | --help)
  echo "usage: kaizen internal sleep-lock-monitor    lock the shell before each suspend (kaizen-sleep-lock.service)"
  exit 0
  ;;
esac

lock_and_wait() {
  kaizen ipc call lock lock >/dev/null || return 1

  for _ in $(seq 1 30); do
    if kaizen ipc call lock status 2>/dev/null | grep -q '"secure":true'; then
      echo "kaizen: session lock is secure, releasing the suspend delay"
      return 0
    fi
    sleep 0.1
  done

  return 1
}

# A child holds the delay inhibitor, so releasing it before a suspend keeps
# this process, and the unit, running.
holder=""

hold_delay() {
  [[ -z $holder ]] || return 0
  systemd-inhibit \
    --what=sleep \
    --mode=delay \
    --who=kaizen \
    --why="Secure the Quickshell lock screen before suspend" \
    sleep infinity &
  holder=$!
}

release_delay() {
  # Killing systemd-inhibit also ends its child and releases the lock.
  kill "$holder" 2>/dev/null || echo "<4>kaizen: the suspend delay was not held" >&2
  wait "$holder" || true
  holder=""
}

monitor_sleep() {
  hold_delay
  while IFS= read -r line; do
    case $line in
    *"boolean true"*)
      # <4>: the journal's warning priority, which `kaizen doctor` lists.
      lock_and_wait || echo "<4>kaizen: session lock was not secure before suspend" >&2
      release_delay
      ;;
    *"boolean false"*)
      hold_delay
      ;;
    esac
  done < <(dbus-monitor --system \
    "type='signal',sender='org.freedesktop.login1',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'")
  echo "kaizen: dbus-monitor exited" >&2
  return 1
}

monitor_sleep
