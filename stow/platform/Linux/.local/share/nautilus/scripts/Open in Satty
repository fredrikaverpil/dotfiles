#!/usr/bin/env bash
# shellcheck shell=bash
set -e

# Nautilus script: opens each selected image in satty.
# Saving writes a new PNG next to it; magick decodes formats satty cannot, like HEIC.
for f in "$@"; do
  # satty expands strftime specifiers in the output name.
  out="${f%.*}"
  out="${out//%/%%}-edited-%Y%m%d-%H%M%S.png"
  # The first image only, which satty shows; 8-bit at zlib level 1, since the
  # PNG only crosses a pipe.
  magick "${f}[0]" -auto-orient -depth 8 -define png:compression-level=1 png:- |
    satty --filename - --output-filename "$out" --early-exit save ||
    notify-send "Open in Satty" "Failed: $f"
done
