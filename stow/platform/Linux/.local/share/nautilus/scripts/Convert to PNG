#!/usr/bin/env bash
# shellcheck shell=bash
set -e

# Nautilus script: writes a PNG next to each selected image, never overwriting.
for f in "$@"; do
  out="${f%.*}.png"
  if [[ -e $out ]]; then
    notify-send "Convert to PNG" "Skipped $f: $out exists"
    continue
  fi
  # 8-bit at zlib level 3: magick's defaults write 16-bit from 10-bit HEIC and
  # compress on one core, about 15x slower for a few percent smaller files.
  magick "$f" -auto-orient -depth 8 -define png:compression-level=3 "$out" ||
    notify-send "Convert to PNG" "Failed: $f"
done
