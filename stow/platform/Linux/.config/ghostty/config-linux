# Included from the shared config; Linux-only overrides.

# Ghostty converts points via display DPI: 96 on Linux/GTK vs 72 on macOS.
font-size = 10.5

# Light weights turn spindly on a low-DPI panel. An empty value clears the
# shared list before re-adding.
font-variation =
font-variation = wght=400
font-variation = wdth=100
font-variation-italic =
font-variation-italic = wght=400


# `main` pins the quick terminal to the primary output; `mouse` leaves the
# output to the compositor, which picks the focused one.
quick-terminal-screen = mouse

# Default toggles fullscreen; let ctrl+enter reach the app.
keybind = ctrl+enter=unbind

# window-title-font-family does not reach the libadwaita tab bar.
gtk-custom-css = tabs.css
