# shellcheck shell=sh
# uwsm reads this file when a kaizen session starts and gives these variables
# to every program in the session.

# GTK 3 apps get dark mode and the theme from the portal, even when they cannot
# read GNOME's settings themselves, and open its file picker.
export GTK_USE_PORTAL=1

# Qt apps copy their look from GTK: dark or light, colours, fonts and icons.
# Without it they stay light and show no themed icon
export QT_QPA_PLATFORMTHEME=gtk3

# This tells older Electron apps from nixpkgs to run as real Wayland
# apps instead of through Xwayland, which looks blurry on scaled screens.
export NIXOS_OZONE_WL=1
