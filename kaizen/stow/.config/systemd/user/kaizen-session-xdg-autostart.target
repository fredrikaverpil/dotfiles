# kaizen's units that start with the XDG autostart apps, under each kaizen
# entry's wayland-session-xdg-autostart@<entry>.target.
[Unit]
Description=XDG autostart for the kaizen session
# Not PartOf=graphical-session.target: a target orders after the units it is
# part of, and graphical-session.target after the entry's target, a cycle.
StopWhenUnneeded=yes

[Install]
WantedBy=wayland-session-xdg-autostart@kaizen_niri.desktop.target
WantedBy=wayland-session-xdg-autostart@kaizen_umbriel.desktop.target
