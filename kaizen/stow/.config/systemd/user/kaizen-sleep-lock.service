# Lid close and the power key suspend via logind; this delay inhibitor locks the
# shell first and releases once the lock reports secure.
[Unit]
Description=Lock Quickshell before suspend
PartOf=graphical-session.target
# Match Quickshell's ordering: waitenv waits for the compositor, and
# graphical-session.target cycles.
After=dbus.socket wayland-session-waitenv.service
Requires=dbus.socket

[Service]
ExecStart=/usr/bin/env kaizen internal sleep-lock-monitor
Restart=always
RestartSec=2s

[Install]
WantedBy=kaizen-session.target
