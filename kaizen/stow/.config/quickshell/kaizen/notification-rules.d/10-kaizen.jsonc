// kaizen's notification rules. Each file here and in
// ~/.config/kaizen/notification-rules.d/ holds a list of rules; the shell reads
// them together in file-name order. Fields are described at `ruleCheck` in
// ~/.config/quickshell/kaizen/modules/notifications/NotificationLogic.js.
[
  // Satty's image is a temp file it may delete before the toast loads it.
  {
    "match": { "app": "^satty$" },
    "badgeIcon": "../icons/satty.svg"
  }
]
