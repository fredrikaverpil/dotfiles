# What the core calls or reads, checked by `kaizen doctor` and requires-check.
# One per line: cmd NAME, bus session|system NAME, file PATH, data PATH (in the
# XDG data dirs), env NAME=VALUE (in the user manager's environment), font FAMILY
# (the rest of the line, any case), qtplugin PATH (in the running shell's Qt
# plugin dirs). Missing is an error unless the line ends in `warn`; a line in
# another form is an error. kaizen/nix/requires.nix fails a host's build on a
# `cmd`, `file` or `data` line here or in an enabled plugin's requires that the
# host does not install.

# Session
cmd niri
cmd uwsm
cmd uwsm-app
cmd quickshell
cmd qs
cmd systemctl
cmd systemd-run
cmd systemd-inhibit
cmd journalctl
cmd busctl
cmd dbus-monitor
cmd jq
cmd git
cmd wtype
file /etc/kaizen
file /etc/pam.d/kaizen-lock
bus system org.freedesktop.login1
bus session org.freedesktop.portal.Desktop
# The portal's GNOME (screencast, file chooser) and GTK backends.
data xdg-desktop-portal/portals/gnome.portal
data xdg-desktop-portal/portals/gtk.portal
env NIXOS_OZONE_WL=1
env QT_QPA_PLATFORMTHEME=gtk3
env GTK_USE_PORTAL=1

# Desktop
cmd ghostty
cmd xdg-terminal-exec
# Names ghostty as xdg-terminal-exec's default.
file /etc/xdg/xdg-terminals.list
cmd xdg-open
cmd notify-send
cmd wl-copy
cmd wl-paste
cmd dconf
cmd kwriteconfig6
cmd magick
cmd pw-play
cmd wl-gammarelay-rs
cmd wl-mirror
data kaizen/emoji.json
# Quickshell's WebP decoder.
qtplugin imageformats/libqwebp.so
font JetBrainsMono Nerd Font
font Noto Color Emoji
# Licensed, installed by hand; Ui/Fonts.qml falls back to JetBrains Mono.
font Berkeley Mono Variable warn

# Recording
cmd grim
cmd satty
cmd gpu-screen-recorder
cmd mpv

# Network and Bluetooth
cmd ip
cmd ping
cmd nmcli
cmd nm-connection-editor
cmd bluetui
bus system org.freedesktop.NetworkManager
bus system org.bluez

# Power, clock, weather, firmware
bus system org.freedesktop.UPower
bus system org.freedesktop.UPower.PowerProfiles
bus system org.freedesktop.timedate1
cmd timedatectl
cmd zdump
cmd curl
cmd fwupdmgr warn
bus system org.freedesktop.fwupd warn
