#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

case "${1:-}" in
-h | --help)
  echo "usage: kaizen run    start the session from a TTY login shell"
  exit 0
  ;;
?*)
  printf 'kaizen run: unknown argument: %s\nusage: kaizen run\n' "$1" >&2
  exit 2
  ;;
esac

# uwsm's login-shell test reads its parent's command line, which is this
# script's. `kaizen` execs this script, so its parent is the shell to test.
arg0=""
read -r -d '' arg0 <"/proc/$PPID/cmdline" || true
if [[ $arg0 != -* ]]; then
  echo "kaizen: run it from a TTY login shell" >&2
  exit 1
fi
uwsm check may-start -i

# `kaizen` put its own directory, a store path, first on PATH, and uwsm exports
# PATH to the session. Drop it, so the session's `kaizen` follows rebuilds.
PATH=${PATH#"$(dirname "$(command -v kaizen)")":}

# The entry runs `niri --session`, which serves niri's D-Bus interfaces
# (screencast portal, a11y) and imports its environment, which uwsm cleans up
# on exit. The instance name is the entry ID, so the units are
# wayland-wm@kaizen.desktop.service and wayland-session@kaizen.desktop.target --
# both named in kaizen/stow/.config/systemd/user/. A plain `uwsm start niri`
# starts none of kaizen.
exec uwsm start -- kaizen.desktop
