#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

case "${1:-}" in
"" | -h | --help)
  echo "usage: kaizen focus APP_ID_REGEX COMMAND [ARGS...]    focus the app, or open it"
  exit 0
  ;;
esac

regex="$1"
shift
case "${KAIZEN_COMPOSITOR:-}" in
umbriel)
  # umbriel has no focus timestamp: the active window, else the first match.
  id="$(umbriel windows --json | jq -r --arg re "$regex" \
    '[.[] | select(.app_id // "" | test($re))] | (map(select(.active)) + .)[0].id // empty')"
  if [ -n "$id" ]; then
    exec umbriel msg "window-focus:$id"
  fi
  ;;
niri)
  id="$(niri msg -j windows | jq --arg re "$regex" \
    '[.[] | select(.app_id // "" | test($re))] | max_by(.focus_timestamp | [.secs, .nanos]) | .id // empty')"
  if [ -n "$id" ]; then
    exec niri msg action focus-window --id "$id"
  fi
  ;;
*)
  echo "kaizen focus: KAIZEN_COMPOSITOR names no compositor: ${KAIZEN_COMPOSITOR:-it is unset}" >&2
  exit 1
  ;;
esac
exec "$@"
