#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

case "${1:-}" in
-h | --help)
  echo "usage: kaizen ipc [-q] show [TARGET] | call TARGET FN [ARGS...]    list the shell's IPC functions by target, or call one; -q is silent and succeeds when it cannot"
  exit 0
  ;;
esac

# -q is for binds and units that can run while the shell restarts.
quiet=false
if [[ ${1:-} == -q ]]; then
  quiet=true
  shift
  exec >/dev/null 2>&1
fi

# Selects the unit's process, whatever tree it runs and on any display. qs
# refuses config selection beside --pid.
pid=$(systemctl --user show kaizen-shell.service -p MainPID --value)
if [[ ${pid:-0} == 0 ]]; then
  echo "kaizen-shell is not running" >&2
  $quiet && exit 0
  exit 1
fi
unset QS_CONFIG_NAME QS_CONFIG_PATH QS_MANIFEST

# qs ipc call prints its own errors on stdout and exits 0; these are their
# first lines.
errors='^(Target not found\.|Function not found\.|Too (many|few) arguments provided|Unable to parse argument |Not ready to accept queries yet\.|Error occurred while waiting for response\.|Received invalid IPC response|(Target|Function) required to send message\.)'
if [[ ${1:-} == call ]]; then
  status=0
  out=$(qs ipc --pid "$pid" "$@") || status=$?
  if [[ $status == 0 && $out =~ $errors ]]; then
    printf '%s\n' "$out" >&2
    status=1
  elif [[ -n $out ]]; then
    printf '%s\n' "$out"
  fi
  $quiet && exit 0
  exit "$status"
fi

# Anything but show and call is qs ipc's own.
if [[ ${1:-} != show ]]; then
  if $quiet; then
    qs ipc --pid "$pid" "$@" || true
    exit 0
  fi
  exec qs ipc --pid "$pid" "$@"
fi

qs ipc --pid "$pid" show |
  awk -v t="${2:-}" '/^target /{n=$2} t=="" || n==t {print n "\t" $0}' |
  sort -s -t "$(printf '\t')" -k1,1 |
  cut -f2-
